#!/usr/bin/env bash

set -eo pipefail

if [[ -n "${DEBUG}" ]]; then
    set -x
fi

from=$1
to=$2

if [[ "${to}" == "${FILES_DIR}" || "${to}" =~ ^"${FILES_DIR}/" ]]; then
    # Archives can contain 0755 directories and 0644 files. Both runtime users
    # need access after import; retain executable bits and existing other modes.
    rsync -rltpog --chown=www-data:www-data --chmod=Du+rwx,Dg+rwx,Dg+s,Fu+rw,Fg+rw "${from}" "${to}"
    find "${to}" -type d -exec files_prepare_dirs {} +
    # Ensure files volume permissions are still correct.
    init_container
else
    echo "Invalid destination. Must be under ${FILES_DIR}"
    exit 1
fi
